<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Local connection-status readout only; never scans for SSIDs. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
    <application
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Explicit sharesheet opt-in. Never ingest files, HTML or URLs. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <!-- Explicit "Open with Tuddy" from Android Files/providers.
                 Only content:// URI grants, bounded UTF-8 and human preview. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="content"/>
                <data android:mimeType="text/plain"/>
                <data android:mimeType="text/vtt"/>
                <data android:mimeType="text/srt"/>
                <data android:mimeType="application/x-subrip"/>
                <data android:mimeType="application/json"/>
                <data android:mimeType="text/x-ass"/>
                <data android:mimeType="text/x-ssa"/>
                <data android:mimeType="application/x-ass"/>
                <data android:mimeType="application/ttml+xml"/>
                <data android:mimeType="application/xml"/>
                <data android:mimeType="text/xml"/>
            </intent-filter>
            <!-- Explicit one-file Android Share: selected content URI only.
                 No generic */* receiving and no multi-file permissions. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/vtt"/>
                <data android:mimeType="text/srt"/>
                <data android:mimeType="application/x-subrip"/>
                <data android:mimeType="application/json"/>
                <data android:mimeType="text/x-ass"/>
                <data android:mimeType="text/x-ssa"/>
                <data android:mimeType="application/x-ass"/>
                <data android:mimeType="application/ttml+xml"/>
                <data android:mimeType="application/xml"/>
                <data android:mimeType="text/xml"/>
            </intent-filter>
            <!-- A single user-selected, content:// personal CSV goes to the
                 bounded phrasebook preview, never directly to storage. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="content"/>
                <data android:mimeType="text/csv"/>
                <data android:mimeType="application/csv"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/csv"/>
                <data android:mimeType="application/csv"/>
            </intent-filter>
            <!-- Android text-selection entrypoint; MainActivity forwards ordinary text internally. -->
            <intent-filter android:label="Vertaal met Tuddy">
                <action android:name="android.intent.action.PROCESS_TEXT"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>
        <!-- Optional Android home-screen widget. It has no microphone, data,
             storage or network entrypoint; taps only open explicit app screens. -->
        <receiver
            android:name=".TuddyQuickActionsWidget"
            android:exported="false"
            android:label="@string/tuddy_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tuddy_quick_actions_widget_info"/>
        </receiver>
        <!-- SystemUI-only, signature-protected Quick Settings entrypoint.
             It opens an explicit readiness screen after unlock; no background capture. -->
        <service
            android:name=".TuddyOfflineQuickSettingsTile"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:label="@string/tuddy_qs_tile_name"
            android:icon="@drawable/tuddy_offline_check_tile">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>
    <activity
        android:name=".QuickTranslateActivity"
        android:label="Vertaal met Tuddy"
        android:exported="false"
        android:excludeFromRecents="true"/>
    </application>
</manifest>