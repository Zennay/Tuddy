<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="6dp"
    android:background="@drawable/tuddy_widget_panel">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/tuddy_widget_title"
        android:textStyle="bold"
        android:textSize="13sp"
        android:textColor="#FFFFFF"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tuddy_widget_type"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:background="@drawable/tuddy_widget_action"
            android:text="@string/tuddy_widget_compact_type"
            android:contentDescription="@string/tuddy_widget_type"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/tuddy_widget_check"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:gravity="center"
            android:background="@drawable/tuddy_widget_action"
            android:text="@string/tuddy_widget_compact_check"
            android:contentDescription="@string/tuddy_widget_check"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tuddy_widget_sentence"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:background="@drawable/tuddy_widget_action"
        android:text="@string/tuddy_widget_compact_sentence"
        android:contentDescription="@string/tuddy_widget_sentence"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#FFFFFF"
        android:textSize="12sp"/>
</LinearLayout>
